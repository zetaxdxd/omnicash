# OmniCash - variables de entorno
# Copia este archivo como .env y ajusta los valores

# Puerto del servidor HTTP
PORT=4000

# ----- CORREO TRANSACCIONAL (Brevo recomendado) -----
# Brevo (https://www.brevo.com) permite 300 correos/día gratis y NO bloquea
# servidores en la nube (Render). Gmail bloquea datacenters y por eso
# los códigos no llegaban desde producción.
#
# SMTP_HOST: smtp-relay.brevo.com
# SMTP_PORT: 2525 (Render bloquea los puertos 587 y 465 salientes; 2525 está abierto)
# SMTP_USER: tu correo de la cuenta Brevo
# SMTP_PASSWORD: tu "Master Password" SMTP (menú SMTP & API)
# EMAIL_FROM: nombre del remitente (ej: OmniCash Banco)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OmniCash Banco

# Respaldos si SMTP_HOST está vacío: Gmail con contraseña de aplicación
#   Pasos: Verificación en 2 pasos activada -> Contraseñas de aplicaciones -> Crear una
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ----- IDENTIDAD DEL BANCO -----
# Código de banco (3 dígitos) y agencia (5 dígitos) para numerar cuentas tipo CCI
BANK_CODE=606
BANK_AGENCY=00001

# ----- SEGURIDAD -----
# Tiempo de vida del código OTP (minutos)
OTP_TTL_MINUTES=10
# Intentos fallidos antes de bloquear temporalmente el login
LOGIN_MAX_ATTEMPTS=5
# Minutos de bloqueo temporal tras superar los intentos
LOGIN_BLOCK_MINUTES=15
# Duración de la sesión (ej: 2h, 12h, 7d)
SESSION_TTL=30d
# Operaciones de monto igual o mayor requieren reautenticación (créditos)
SENSITIVE_OPERATION_MIN=100

# ----- RENIEC (validación de identidad) -----
# RENIEC no tiene API pública. Si obtienes un token de un proveedor de
# consulta DNI (ej. decolecta.com / apis.net.pe), pónlo aquí y el registro
# autocompletará nombre y apellidos con los datos del DNI. Deja vacío para
# modo OFFLINE (entrada manual, recomendado para desarrollo).
RENIEC_API_URL=https://api.decolecta.com/v1/reniec/dni
RENIEC_TOKEN=
# Máximo de cuentas permitidas por DNI (regla de prevención de fraude)
MAX_CUENTAS_POR_DNI=2

# ----- MÓDULO BANCARIO -----
# Límite diario de retiro en cajero (en créditos)
ATM_DAILY_LIMIT=1000
# Comisión del cajero por retiro (0.05 = 5%)
ATM_FEE=0.05

# ----- YAPE REAL (dinero que llega a tu celular BCP) -----
# Número de tu Yape personal: ahí llega el dinero que envían los clientes.
# YAPE_MERCHANT_NAME: nombre que verán los clientes al pedir el depósito.
# Topes: por operación y acumulado diario (en soles).
YAPE_MERCHANT_PHONE=921901846
YAPE_MERCHANT_NAME=OmniCash
YAPE_MAX_AMOUNT=1000
YAPE_DAILY_LIMIT=3000

# ----- BASE DE DATOS -----
# URL de conexión a PostgreSQL (Neon). Vacío = SQLite local (desarrollo).
# Ejemplo: postgresql://usuario:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Ruta del archivo de base de datos SQLite
DB_PATH=data/omnicash.db

# Secreto de firma (mantener para compatibilidad; la sesión ahora es por token opaco)
JWT_SECRET=omnicash_dev_secret_cambiar_en_produccion
